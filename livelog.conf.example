# livelog configuration
# Format: key = value
# Lines that start with # are comments.
# You can put a value in "double quotes" to keep spaces at its start or end.
# The program reads livelog.conf next to itself (or use: livelog -c /path/file.conf).

# Command to run. Its output is read live, line by line.
# If the command stops, livelog waits restart_delay seconds and runs it again.
command = asterisk -rvvvvv

# A line that STARTS with this text begins a new chunk (case sensitive).
event_prefix = EVENT

# Texts to look for in the EVENT line (case sensitive).
# Write one "match =" line for each text.
# If there is no match line, every chunk is logged.
match = SIP/100
match = SIP/200

# any = the EVENT line must have at least one of the texts
# all = the EVENT line must have every text
match_mode = any

# Key for the log file encryption. Change it! (max 248 characters)
# You need the same key to read the files with livelog-decrypt.
key = change-me-please

# Folder for the log files.
log_dir = /var/log/livelog

# File name is: <file_prefix>yyyymmdd.log  ->  ast-20261021.log
file_prefix = ast-

# Keep only the newest N log files. Older files are deleted. 0 = keep all.
keep_files = 20

# Seconds to wait before running the command again after it stops.
restart_delay = 5

# yes = run the command in a pseudo-terminal (needed for "asterisk -r").
# no  = use a simple pipe.
use_pty = yes

# yes = remove color codes and other control characters from each line.
strip_ansi = yes

# ---------- FTP upload (optional) ----------
# If ftp_server is set, the log files are uploaded to an FTP server.
# Plain FTP, passive mode (FTPS / SFTP are not supported).
# The uploaded files are still encrypted. Only the FTP password is not hidden on the network.
# Every ftp_interval seconds: first the file of today, then the file before it,
# then all older files (newest to oldest). Files are uploaded only if their size
# is different on the server. Files are never deleted on the server.
#ftp_server = ftp.example.com
#ftp_user = myuser
#ftp_password = mypassword

# Target folder on the server. It is created if it is missing. Empty = login folder.
#ftp_path = /livelog/pbx1

# Seconds between two upload rounds (counted from the end of the last round).
#ftp_interval = 60

# FTP port.
#ftp_port = 21

# If the upload of today's file or of the file before it fails, it is tried again
# ftp_retries times, ftp_retry_delay seconds apart. Then the round goes on.
# Older files get one try per round (they are tried again in the next round).
#ftp_retries = 10
#ftp_retry_delay = 10

# Seconds to wait for the server (connect, reply, data) before the try fails.
#ftp_timeout = 30
